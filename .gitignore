# ==============================================================================
# Git Ignore for Smart-Drip (ESP32-S3, PlatformIO, C++, Python TinyML)
# ==============================================================================

# --- PlatformIO & Embedded Firmware Build Artifacts ---
.pio/
.pioenvs/
.piolibdeps/
.clangd/

# --- C / C++ Compiled Binaries and Objects ---
*.o
*.obj
*.so
*.dylib
*.dll
*.a
*.lib
*.elf
*.bin
*.hex
*.map
*.d
*.out
*.app
*.i
*.s

# --- CMake / Build Systems ---
build/
bin/
out/
CMakeCache.txt
CMakeFiles/
cmake-build-*/
Makefile.old
compile_commands.json

# --- Sensitive Credentials & Local Overrides ---
include/config.h
private_credentials.h
secrets.h
*.local.h
.env
.env.*
!.env.example

# --- IDEs & Editors ---
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# CLion / JetBrains
.idea/
*.iml
cmake-build-debug/
cmake-build-release/

# Eclipse / Keil / IAR
.project
.cproject
.settings/
*.uvprojx
*.uvoptx

# --- Python TinyML Environment & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.ipynb_checkpoints/

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- Temporary & Backup Files ---
*~
*.bak
*.swp
*.swo
*.tmp
*.log
